---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/instrument-serif/400-italic.css';
import 'lenis/dist/lenis.css';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0B1F33" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="image" type="image/avif" href="/images/hero-main/hero-main-1600.avif" imagesrcset="/images/hero-main/hero-main-800.avif 800w, /images/hero-main/hero-main-1200.avif 1200w, /images/hero-main/hero-main-1600.avif 1600w, /images/hero-main/hero-main-2400.avif 2400w" imagesizes="100vw" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (reduce) root.classList.add('rm');
          if (!reduce && !sessionStorage.getItem('loader-seen')) root.classList.add('has-loader');
          sessionStorage.setItem('loader-seen', '1');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
